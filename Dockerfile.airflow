ARG AIRFLOW_VERSION=3.3.2
FROM apache/airflow:${AIRFLOW_VERSION}

# Spark needs Java. If apt cannot find 17 on this Debian release, use
# openjdk-21-jre-headless instead (Spark 4.x supports both).
USER root
RUN apt-get update \
 && apt-get install -y --no-install-recommends openjdk-17-jre-headless \
 && apt-get clean && rm -rf /var/lib/apt/lists/*

USER airflow
# Install only the pyspark pin from requirements.txt (single source of truth).
# requests is already part of Airflow, and pytest is not needed inside the image.
COPY requirements.txt /tmp/requirements.txt
RUN grep -i '^pyspark==' /tmp/requirements.txt | xargs pip install --no-cache-dir